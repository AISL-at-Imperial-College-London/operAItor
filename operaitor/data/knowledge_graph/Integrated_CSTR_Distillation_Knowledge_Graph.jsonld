      {
        "@id": "http://example.org/integrated_cstr_distillation#Equation_H2_Removal",
        "@type": [
          "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
          {
            "@language": "en",
            "@value": "Fvent = PCV_open*Cv_pcv*sqrt(max(P-Pback,0)) + BDV_open*Cv_bdv*sqrt(max(P-Pback,0)) + PSV_open(P)*Cv_psv*sqrt(max(P-Pback,0)); PSV starts at 4.50 bar and is full-open by 4.70 bar."
          }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
          {
            "@language": "en",
            "@value": "Hydrogen removal flow"
          }
        ]
      },
      {
        "@id": "http://example.org/integrated_cstr_distillation#TD_cstr_bdv_valve",
        "@type": [
          "http://www.hsu-ifa.de/ontologies/DINEN61360#Type_Description"
        ],
