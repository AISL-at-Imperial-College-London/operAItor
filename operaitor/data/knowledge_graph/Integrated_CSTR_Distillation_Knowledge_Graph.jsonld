      {
        "@id": "http://example.org/integrated_cstr_distillation#Equation_CSTR_Rate",
        "@type": [
          "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
          {
            "@language": "en",
            "@value": "rate = catalyst_activity * k_ref * exp[-E/R*(1/T - 1/T_ref)] * positive(M_liq - n_acetone)."
          }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
          {
            "@language": "en",
            "@value": "CSTR reaction rate"
          }
        ]
      },
