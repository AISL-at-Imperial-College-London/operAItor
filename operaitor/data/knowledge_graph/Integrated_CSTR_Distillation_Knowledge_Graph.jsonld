          "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
          {
            "@language": "en",
            "@value": "actual fresh_ipa_feed = requested fresh_ipa_feed unless selected P-101 pump is failed, in which case actual flow = 0."
