      {
        "@id": "http://example.org/integrated_cstr_distillation#Equation_BOT_TIC",
        "@type": [
          "http://www.w3id.org/hsu-aut/VDI2206#MathematicalModel"
        ],
        "http://example.org/integrated_cstr_distillation/ontology#sourceFile": [
          {
            "@value": "integrated_plant/control.py"
          }
        ],
        "http://example.org/integrated_cstr_distillation/ontology#sourceSymbol": [
          {
            "@value": "PIController.output"
          }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
          {
            "@language": "en",
            "@value": "u = clip(bias + Kp*(SP-PV) + integral, u_min, u_max); integral += Kp/Ti*(SP-PV)*dt outside deadband (PV first-order filtered); AUTO/MANUAL transfer uses tracking/back-calculation. Kp=0.0975, Ti=0.15 h, deadband=0.1342, PV filter time constant=2 min."
          }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
          {
            "@language": "en",
            "@value": "BOT_TIC PI control law"
          }
        ]
      },
