        VDI3682:hasInput int:information_DR_LIC_sp,
            int:information_drum_holdup_kmol ;
        VDI3682:hasOutput int:information_distillate_flow ;
        VDI3682:isAssignedTo int:module_CondenserDrum .

    int:PO_FreshFeed a VDI3682:ProcessOperator ;
        rdfs:label "PO – Fresh IPA Feed"@en ;
        CPSMod:processRealizesBehavior int:Equation_FeedPump ;
        rdfs:comment "P-101 duty/standby service delivers the fresh-feed request unless the selected pump is failed."@en ;
        VDI3682:hasInput int:information_fresh_feed_temperature_K,
            int:information_fresh_ipa_feed,
