    ip:limitValue a owl:DatatypeProperty ;
        rdfs:label "limitValue"@en ;
        rdfs:comment "Alarm or trip limit"@en .

    ip:mode a owl:DatatypeProperty ;
        rdfs:label "mode"@en ;
        rdfs:comment "Fault/action mode"@en .

    ip:monitorsParameter a owl:ObjectProperty ;
        rdfs:label "monitorsParameter"@en ;
        rdfs:comment "Links alarm/SIF/controller to a monitored parameter"@en .

    ip:mvMaximum a owl:DatatypeProperty ;
        rdfs:label "mvMaximum"@en ;
        rdfs:comment "Maximum manipulated-variable command"@en .

    ip:mvMinimum a owl:DatatypeProperty ;
        rdfs:label "mvMinimum"@en ;
        rdfs:comment "Minimum manipulated-variable command"@en .

