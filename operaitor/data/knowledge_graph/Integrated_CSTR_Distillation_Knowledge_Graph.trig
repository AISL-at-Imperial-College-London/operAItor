    int:sym_bottoms_acetone_high a DIN17359:Symptom ;
        rdfs:label "Bottoms Acetone High"@en ;
        DIN17359:SymptomIsExtractedFromFeature int:feat_bottoms_quality ;
        rdfs:comment "Bottoms Acetone High."@en .

    int:transition_running_completed a UML:Transition ;
        rdfs:label "RUNNING → COMPLETED"@en ;
        ip:guardExpression "t >= horizon_h AND horizon_is_completion == True" ;
        UML:source int:state_RUNNING ;
        UML:target int:state_COMPLETED ;
        UML:transitionGuard "t >= horizon_h AND horizon_is_completion == True" ;
        rdfs:comment "Outcome transition to COMPLETED."@en .

    int:transition_running_damage a UML:Transition ;
        rdfs:label "RUNNING → DAMAGE"@en ;
        ip:guardExpression "reactor P >= 5.0 bar for 2 min OR column P >= 1.8 bar for 2 min OR reboiler holdup <= 5 kmol with steam valve > 0.03 for 5 min OR CSTR holdup >= 79 kmol" ;
        UML:source int:state_RUNNING ;
        UML:target int:state_DAMAGE ;
        UML:transitionGuard "reactor P >= 5.0 bar for 2 min OR column P >= 1.8 bar for 2 min OR reboiler holdup <= 5 kmol with steam valve > 0.03 for 5 min OR CSTR holdup >= 79 kmol" ;
        rdfs:comment "Outcome transition to DAMAGE."@en .

    int:transition_running_model_limit a UML:Transition ;
        rdfs:label "RUNNING → MODEL_LIMIT"@en ;
        ip:guardExpression "any tray holdup < 0.10 kmol" ;
        UML:source int:state_RUNNING ;
        UML:target int:state_MODEL_LIMIT ;
        UML:transitionGuard "any tray holdup < 0.10 kmol" ;
        rdfs:comment "Outcome transition to MODEL_LIMIT."@en .

    int:transition_running_numerical_failure a UML:Transition ;
        rdfs:label "RUNNING → NUMERICAL_FAILURE"@en ;
        ip:guardExpression "implicit integration / nonlinear solve fails" ;
        UML:source int:state_RUNNING ;
        UML:target int:state_NUMERICAL_FAILURE ;
        UML:transitionGuard "implicit integration / nonlinear solve fails" ;
        rdfs:comment "Outcome transition to NUMERICAL_FAILURE."@en .

    int:transition_running_recovered a UML:Transition ;
        rdfs:label "RUNNING → RECOVERED"@en ;
        ip:guardExpression "abnormal_seen AND NOT external_abnormal_active AND no SIF latched AND near_nominal for 15 min" ;
        UML:source int:state_RUNNING ;
        UML:target int:state_RECOVERED ;
        UML:transitionGuard "abnormal_seen AND NOT external_abnormal_active AND no SIF latched AND near_nominal for 15 min" ;
        rdfs:comment "Outcome transition to RECOVERED."@en .

    int:transition_running_safe_trip a UML:Transition ;
        rdfs:label "RUNNING → SAFE_TRIP"@en ;
        ip:guardExpression "(terminate_on_plant_trip AND plant_trip_latched) OR (plant_trip_latched AND safe_envelope for 15 min)" ;
        UML:source int:state_RUNNING ;
        UML:target int:state_SAFE_TRIP ;
        UML:transitionGuard "(terminate_on_plant_trip AND plant_trip_latched) OR (plant_trip_latched AND safe_envelope for 15 min)" ;
        rdfs:comment "Outcome transition to SAFE_TRIP."@en .

    int:transition_running_timeout a UML:Transition ;
        rdfs:label "RUNNING → TIMEOUT"@en ;
        ip:guardExpression "t >= horizon_h AND horizon_is_completion == False" ;
        UML:source int:state_RUNNING ;
        UML:target int:state_TIMEOUT ;
        UML:transitionGuard "t >= horizon_h AND horizon_is_completion == False" ;
        rdfs:comment "Outcome transition to TIMEOUT."@en .

    ip:actsOn a owl:ObjectProperty ;
        rdfs:label "actsOn"@en ;
        rdfs:comment "Operator action target"@en .

    ip:affectsParameter a owl:ObjectProperty ;
        rdfs:label "affectsParameter"@en ;
        rdfs:comment "Fault/disturbance affects a parameter"@en .

