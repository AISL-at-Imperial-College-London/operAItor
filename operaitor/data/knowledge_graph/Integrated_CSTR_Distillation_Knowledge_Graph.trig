            int:information_column_pressure_bar ;
        VDI3682:hasOutput int:information_condenser_cooling_valve ;
        VDI3682:isAssignedTo int:module_CondenserDrum .

    int:PO_DR_LIC a VDI3682:ProcessOperator ;
