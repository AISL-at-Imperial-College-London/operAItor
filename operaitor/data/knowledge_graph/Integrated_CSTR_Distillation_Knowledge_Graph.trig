@prefix CPSMod: <http://www.hsu-ifa.de/ontologies/CPSMod#> .
@prefix DIN17359: <http://www.hsu-ifa.de/ontologies/DIN17359#> .
@prefix DINEN61360: <http://www.hsu-ifa.de/ontologies/DINEN61360#> .
@prefix UML: <http://www.hsu-ifa.de/ontologies/UMLStateMachine#> .
@prefix VDI2206: <http://www.w3id.org/hsu-aut/VDI2206#> .
@prefix VDI3682: <http://www.w3id.org/hsu-aut/VDI3682#> .
@prefix int: <http://example.org/integrated_cstr_distillation#> .
@prefix ip: <http://example.org/integrated_cstr_distillation/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.hsu-ifa.de/graphs/Integrated_CSTR_Distillation_Simulation> {
    int:EpisodeOutcome_StateMachine a UML:StateMachine ;
        rdfs:label "Episode Outcome State Machine"@en ;
        ip:sourceFile "integrated_plant/outcome.py" ;
        ip:sourceSymbol "EpisodeStatus / OutcomeEvaluator.update" ;
        UML:contains int:state_COMPLETED,
            int:state_DAMAGE,
            int:state_MODEL_LIMIT,
            int:state_NUMERICAL_FAILURE,
            int:state_RECOVERED,
            int:state_RUNNING,
            int:state_SAFE_TRIP,
            int:state_TIMEOUT ;
        rdfs:comment "State machine derived from OutcomeEvaluator and EpisodeStatus."@en .

    int:IntegratedPlant_SystemModel a CPSMod:SystemModel ;
        rdfs:label "Integrated CSTR–Distillation Digital Twin System Model"@en ;
        CPSMod:consistsOfBehaviorModel int:Equation_CSTR_Energy,
            int:Equation_CSTR_Mass,
            int:Equation_CSTR_Rate,
            int:Equation_ColumnPressure,
            int:Equation_CondenserCapacity,
            int:Equation_Reboiler,
            int:Equation_Tray_Component,
            int:Equation_Tray_Total ;
        CPSMod:consistsOfFunctionModel int:IntegratedPlant_Process ;
        CPSMod:consistsOfStructureModel int:IntegratedPlant_System ;
        rdfs:comment "System model corresponding to the v0.5.3 direct-residual DAE plus control, safety, fault, measurement and operator layers."@en .

    int:OperatorAuthority a ip:OperatorAuthorityModel ;
        rdfs:label "Restricted Operator / Agent Authority"@en ;
        ip:allowsAction int:action_ACK_ALARM,
            int:action_NO_ACTION,
            int:action_OPERATE_AUXILIARY,
            int:action_RESET_SIF,
            int:action_SELECT_PRIMARY,
            int:action_SET_MANUAL_OUTPUT,
            int:action_SET_MODE,
            int:action_SET_SETPOINT,
            int:action_SET_THROUGHPUT,
            int:action_START_SPARE ;
        ip:prohibitsProperty "SIF thresholds/bypass",
            "catalyst activity",
            "condenser cooling effectiveness",
            "fault activation",
            "leak rates",
            "sensor bias/freeze",
            "utility temperatures/pressures" ;
        ip:sourceFile "integrated_plant/episode.py" ;
        ip:sourceSymbol "EpisodeRunner.action_catalog" ;
        rdfs:comment "Normal supervisory authority explicitly excludes fault/environment injection and SIF threshold/bypass modification."@en .

    int:dist_ambient_temperature a ip:Disturbance ;
        rdfs:label "Ambient Temperature Disturbance"@en ;
        ip:affectsParameter int:exo_param_ambient_temperature_K ;
        ip:mode "15_min_rectangular_step_±10_percent" ;
        ip:sourceFile "integrated_plant/scenario.py" ;
        ip:sourceSymbol "randomized_step_disturbance_scenario" ;
        rdfs:comment "Normal-variability generator may apply one 15 min rectangular ±10% step to this variable; different disturbances may overlap."@en .

    int:dist_cooling_water_temperature a ip:Disturbance ;
        rdfs:label "Cooling-Water Temperature Disturbance"@en ;
        ip:affectsParameter int:exo_param_cooling_water_temperature_K ;
        ip:mode "15_min_rectangular_step_±10_percent" ;
        ip:sourceFile "integrated_plant/scenario.py" ;
        ip:sourceSymbol "randomized_step_disturbance_scenario" ;
        rdfs:comment "Normal-variability generator may apply one 15 min rectangular ±10% step to this variable; different disturbances may overlap."@en .

    int:dist_feed_temperature a ip:Disturbance ;
        rdfs:label "Feed Temperature Disturbance"@en ;
        ip:affectsParameter int:exo_param_fresh_feed_temperature_K ;
        ip:mode "15_min_rectangular_step_±10_percent" ;
        ip:sourceFile "integrated_plant/scenario.py" ;
        ip:sourceSymbol "randomized_step_disturbance_scenario" ;
        rdfs:comment "Normal-variability generator may apply one 15 min rectangular ±10% step to this variable; different disturbances may overlap."@en .

    int:dist_heating_utility_temperature a ip:Disturbance ;
        rdfs:label "CSTR Heating-Utility Temperature Disturbance"@en ;
        ip:affectsParameter int:exo_param_cstr_heating_utility_temperature_K ;
        ip:mode "15_min_rectangular_step_±10_percent" ;
        ip:sourceFile "integrated_plant/scenario.py" ;
