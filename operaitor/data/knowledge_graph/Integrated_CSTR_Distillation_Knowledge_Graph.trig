    int:IntegratedPlant_Process a VDI3682:Process ;
        rdfs:label "Integrated Reaction and Distillation Process"@en ;
        ip:sourceFile "integrated_plant/plant.py" ;
        ip:sourceSymbol "IntegratedPlantDAE" ;
        rdfs:comment "Fresh IPA is reacted in the CSTR; the liquid reactor effluent feeds tray 6 of a 10-stage acetone/IPA column. Hydrogen is separately removed through PCV/BDV/PSV paths. Column overhead is condensed into a reflux drum and split into reflux and distillate; bottoms leave through the reboiler."@en ;
        VDI3682:consistsOf int:PO_BOT_TIC,
            int:PO_COL_PIC,
            int:PO_CSTR_Dynamics,
            int:PO_Column_Stages,
            int:PO_Condenser,
            int:PO_DR_LIC,
            int:PO_FreshFeed,
            int:PO_H2_Removal,
            int:PO_RB_LIC,
            int:PO_R_LIC,
            int:PO_R_PIC,
            int:PO_R_TIC,
            int:PO_Reboiler,
            int:PO_RefluxDrum,
            int:PO_TOP_TIC ;
        VDI3682:hasInput int:energy_condenser_cooling,
            int:energy_cstr_heating,
            int:energy_feed_thermal,
            int:energy_reboiler_steam,
            int:product_fresh_IPA ;
        VDI3682:hasOutput int:product_bottoms,
            int:product_distillate,
            int:product_h2_to_flare .

    int:IntegratedPlant_System a VDI2206:System ;
        rdfs:label "Integrated CSTR + Distillation Plant"@en ;
        ip:hasAlarm int:alarm_BTM_X_H,
            int:alarm_COL_P_H,
            int:alarm_COL_P_HH,
            int:alarm_COL_TRAY_L,
            int:alarm_DIST_X_L,
            int:alarm_DR_L_HH,
            int:alarm_DR_L_LL,
            int:alarm_P101_TRIP,
            int:alarm_P102_TRIP,
            int:alarm_P201_TRIP,
            int:alarm_P202_TRIP,
            int:alarm_P203_TRIP,
            int:alarm_RB_L_HH,
            int:alarm_RB_L_LL,
            int:alarm_R_L_H,
            int:alarm_R_L_HH,
            int:alarm_R_L_L,
            int:alarm_R_L_LL,
            int:alarm_R_P_H,
            int:alarm_R_P_HH,
            int:alarm_R_T_H,
            int:alarm_R_T_HH ;
        ip:hasCommandStage int:stage_ActualInput,
            int:stage_ControllerRequest,
            int:stage_SafetyCommand,
            int:stage_SupervisoryRequest ;
        ip:hasInterlock int:SIF_COL_L_LL,
            int:SIF_COL_P_HH,
            int:SIF_DR_L_HH,
            int:SIF_DR_L_LL,
            int:SIF_RB_L_HH,
            int:SIF_RB_L_LL,
            int:SIF_R_L_HH,
            int:SIF_R_L_LL,
            int:SIF_R_P_HH,
            int:SIF_R_P_HHH,
            int:SIF_R_T_HH ;
        ip:hasOutcomeState int:state_COMPLETED,
            int:state_DAMAGE,
            int:state_MODEL_LIMIT,
            int:state_NUMERICAL_FAILURE,
            int:state_RECOVERED,
            int:state_RUNNING,
            int:state_SAFE_TRIP,
            int:state_TIMEOUT ;
        ip:sourceFile "README.md" ;
        ip:sourceSymbol "Integrated CSTR + distillation autonomous-operation simulator — v0.5.3 prototype" ;
        ip:version "0.5.3" ;
        rdfs:comment "v0.5.3 synthetic abnormal-operation benchmark: liquid CSTR converting IPA to acetone + H2, followed by a 10-stage binary distillation column with regulatory control, alarms, SIFs, operator actions, and fault layers."@en ;
        VDI2206:SystemConsistsOfModule int:module_CSTR,
            int:module_Column,
            int:module_CondenserDrum,
            int:module_Control,
            int:module_Feed,
            int:module_H2Protection,
            int:module_OperatorInterface,
            int:module_Products,
            int:module_Reboiler,
            int:module_Safety .

    int:PO_BOT_TIC a VDI3682:ProcessOperator ;
        rdfs:label "PO – Bottom Temperature / Steam Controller"@en ;
        CPSMod:processRealizesBehavior int:Equation_BOT_TIC ;
        rdfs:comment "Regulatory loop BOT_TIC: PV=bottom_temperature_K, MV=steam_factor."@en ;
        VDI3682:hasInput int:information_BOT_TIC_sp,
            int:information_bottom_temperature_K ;
        VDI3682:hasOutput int:information_steam_factor ;
        VDI3682:isAssignedTo int:module_Reboiler .

    int:PO_COL_PIC a VDI3682:ProcessOperator ;
        rdfs:label "PO – Column Pressure Controller"@en ;
        CPSMod:processRealizesBehavior int:Equation_COL_PIC ;
        rdfs:comment "Regulatory loop COL_PIC: PV=column_pressure_bar, MV=condenser_cooling_valve."@en ;
