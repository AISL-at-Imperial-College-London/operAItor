    int:SIF_COL_L_LL a ip:SafetyInterlock ;
        rdfs:label "SIF COL_L_LL"@en ;
        ip:direction "LOW" ;
        ip:hasOverrideRule int:override_COL_L_LL_1,
            int:override_COL_L_LL_2,
            int:override_COL_L_LL_3,
            int:override_COL_L_LL_4 ;
        ip:implementedBy int:SIS-001 ;
        ip:limitValue 3e-01 ;
        ip:monitorsParameter int:obs_param_column_min_tray_holdup_kmol ;
        ip:plantTrip true ;
        ip:sourceFile "integrated_plant/safety.py" ;
        ip:sourceSymbol "SafetySystem.apply" ;
        rdfs:comment "Independent latched safety function monitoring column_min_tray_holdup_kmol; benchmark threshold, not an engineered SIL set point."@en .

    int:SIF_COL_P_HH a ip:SafetyInterlock ;
