        ip:commandValue 1e+00 ;
        ip:operator "set" ;
        ip:overrideTarget int:act_param_cstr_bdv_valve ;
        rdfs:comment "set cstr_bdv_valve to/at 1.0."@en .

    int:override_R_P_HH_1 a ip:OverrideRule ;
        rdfs:label "R_P_HH override 1"@en ;
        ip:commandValue 0e+00 ;
        ip:operator "set" ;
        ip:overrideTarget int:act_param_cstr_heater_factor ;
        rdfs:comment "set cstr_heater_factor to/at 0.0."@en .

    int:override_R_P_HH_2 a ip:OverrideRule ;
        rdfs:label "R_P_HH override 2"@en ;
        ip:commandValue 1e+00 ;
        ip:operator "set" ;
        ip:overrideTarget int:act_param_cstr_vent_valve ;
        rdfs:comment "set cstr_vent_valve to/at 1.0."@en .

    int:override_R_P_HH_3 a ip:OverrideRule ;
        rdfs:label "R_P_HH override 3"@en ;
        ip:commandValue 1e+00 ;
        ip:operator "set" ;
        ip:overrideTarget int:act_param_cstr_bdv_valve ;
        rdfs:comment "set cstr_bdv_valve to/at 1.0."@en .

    int:override_R_T_HH_1 a ip:OverrideRule ;
        rdfs:label "R_T_HH override 1"@en ;
        ip:commandValue 0e+00 ;
        ip:operator "set" ;
        ip:overrideTarget int:act_param_cstr_heater_factor ;
        rdfs:comment "set cstr_heater_factor to/at 0.0."@en .

    int:override_R_T_HH_2 a ip:OverrideRule ;
        rdfs:label "R_T_HH override 2"@en ;
        ip:commandValue 1e+00 ;
        ip:operator "max" ;
        ip:overrideTarget int:act_param_cstr_emergency_cooling_factor ;
        rdfs:comment "max cstr_emergency_cooling_factor to/at 1.0."@en .

    int:stage_ControllerRequest a ip:CommandStage ;
        rdfs:label "1. BPCS / Controller Request"@en ;
        ip:stageSuccessor int:stage_SupervisoryRequest ;
        rdfs:comment "ctrl.* values generated by regulatory control."@en .

    ip:OperatorAuthorityModel a owl:Class ;
        rdfs:label "OperatorAuthorityModel"@en ;
        rdfs:comment "Machine-readable boundary of permitted supervisory authority"@en .

    int:BDV-101 a DIN17359:DiagnosticSubject,
            VDI2206:Actuator ;
        rdfs:label "H2 Emergency Blowdown Valve (BDV)"@en ;
        rdfs:comment "Independent actively commanded emergency H2 blowdown valve."@en ;
        VDI2206:isConnectedWith int:R-101 .

    int:E-102 a DIN17359:DiagnosticSubject,
            VDI2206:Actuator ;
        rdfs:label "Emergency Reactor Cooling Path"@en ;
        rdfs:comment "Independent emergency cooling path, UA = 50000 kJ/h/K, normally off."@en ;
        VDI2206:isConnectedWith int:R-101 .

    int:Equation_BOT_TIC a VDI2206:MathematicalModel ;
        rdfs:label "BOT_TIC PI control law"@en ;
        ip:sourceFile "integrated_plant/control.py" ;
        ip:sourceSymbol "PIController.output" ;
        rdfs:comment "u = clip(bias + Kp*(SP-PV) + integral, u_min, u_max); integral += Kp/Ti*(SP-PV)*dt outside deadband (PV first-order filtered); AUTO/MANUAL transfer uses tracking/back-calculation. Kp=0.0975, Ti=0.15 h, deadband=0.1342, PV filter time constant=2 min."@en .

    int:Equation_COL_PIC a VDI2206:MathematicalModel ;
        rdfs:label "COL_PIC PI control law"@en ;
        ip:sourceFile "integrated_plant/control.py" ;
        ip:sourceSymbol "PIController.output" ;
        rdfs:comment "u = clip(bias + Kp*(SP-PV) + integral, u_min, u_max); integral += Kp/Ti*(SP-PV)*dt outside deadband (PV first-order filtered); AUTO/MANUAL transfer uses tracking/back-calculation. Kp=-4.5, Ti=0.4 h, deadband=0.002236, PV filter time constant=2 min."@en .

    int:Equation_CSTR_Acetone a VDI2206:MathematicalModel ;
        rdfs:label "CSTR acetone balance"@en ;
        rdfs:comment "dn_acetone/dt = reaction_rate - total_liquid_outflow * x_acetone."@en .

    int:Equation_CSTR_H2 a VDI2206:MathematicalModel ;
        rdfs:label "CSTR hydrogen balance"@en ;
        rdfs:comment "dn_H2/dt = reaction_rate - Fvent."@en .

    int:Equation_CSTR_Pressure a VDI2206:MathematicalModel ;
        rdfs:label "CSTR H2 pressure"@en ;
        rdfs:comment "P = n_H2 * R * T / V_gas(M_liq), using reactor headspace plus 22.75 m3 connected H2-system capacitance."@en .

    int:Equation_DR_LIC a VDI2206:MathematicalModel ;
        rdfs:label "DR_LIC PI control law"@en ;
        ip:sourceFile "integrated_plant/control.py" ;
        ip:sourceSymbol "PIController.output" ;
        rdfs:comment "u = clip(bias + Kp*(SP-PV) + integral, u_min, u_max); integral += Kp/Ti*(SP-PV)*dt outside deadband (PV first-order filtered); AUTO/MANUAL transfer uses tracking/back-calculation. Kp=-12, Ti=4 h, deadband=0.3, PV filter time constant=0 min."@en .

    int:Equation_FeedPump a VDI2206:MathematicalModel ;
        rdfs:label "Feed pump transmission"@en ;
        rdfs:comment "actual fresh_ipa_feed = requested fresh_ipa_feed unless selected P-101 pump is failed, in which case actual flow = 0."@en .

    int:Equation_H2_Removal a VDI2206:MathematicalModel ;
        rdfs:label "Hydrogen removal flow"@en ;
        rdfs:comment "Fvent = PCV_open*Cv_pcv*sqrt(max(P-Pback,0)) + BDV_open*Cv_bdv*sqrt(max(P-Pback,0)) + PSV_open(P)*Cv_psv*sqrt(max(P-Pback,0)); PSV starts at 4.50 bar and is full-open by 4.70 bar."@en .

    int:Equation_RB_LIC a VDI2206:MathematicalModel ;
        rdfs:label "RB_LIC PI control law"@en ;
        ip:sourceFile "integrated_plant/control.py" ;
        ip:sourceSymbol "PIController.output" ;
        rdfs:comment "u = clip(bias + Kp*(SP-PV) + integral, u_min, u_max); integral += Kp/Ti*(SP-PV)*dt outside deadband (PV first-order filtered); AUTO/MANUAL transfer uses tracking/back-calculation. Kp=-12, Ti=4 h, deadband=0.1543, PV filter time constant=2 min."@en .

    int:Equation_R_LIC a VDI2206:MathematicalModel ;
        rdfs:label "R_LIC PI control law"@en ;
        ip:sourceFile "integrated_plant/control.py" ;
        ip:sourceSymbol "PIController.output" ;
        rdfs:comment "u = clip(bias + Kp*(SP-PV) + integral, u_min, u_max); integral += Kp/Ti*(SP-PV)*dt outside deadband (PV first-order filtered); AUTO/MANUAL transfer uses tracking/back-calculation. Kp=-6, Ti=8 h, deadband=0.2236, PV filter time constant=2 min."@en .

    int:Equation_R_PIC a VDI2206:MathematicalModel ;
        rdfs:label "R_PIC PI control law"@en ;
        ip:sourceFile "integrated_plant/control.py" ;
        ip:sourceSymbol "PIController.output" ;
        rdfs:comment "u = clip(bias + Kp*(SP-PV) + integral, u_min, u_max); integral += Kp/Ti*(SP-PV)*dt outside deadband (PV first-order filtered); AUTO/MANUAL transfer uses tracking/back-calculation. Kp=-0.1, Ti=0.3 h, deadband=0.005, PV filter time constant=4 min."@en .

    int:Equation_R_TIC a VDI2206:MathematicalModel ;
        rdfs:label "R_TIC PI control law"@en ;
        ip:sourceFile "integrated_plant/control.py" ;
        ip:sourceSymbol "PIController.output" ;
        rdfs:comment "u = clip(bias + Kp*(SP-PV) + integral, u_min, u_max); integral += Kp/Ti*(SP-PV)*dt outside deadband (PV first-order filtered); AUTO/MANUAL transfer uses tracking/back-calculation. Kp=0.06, Ti=0.24 h, deadband=0.1, PV filter time constant=4 min."@en .

    int:Equation_RefluxDrum a VDI2206:MathematicalModel ;
        rdfs:label "Reflux drum balances"@en ;
        rdfs:comment "dM_drum/dt = Fcond - (reflux + distillate + drum_leak); light-component and energy balances use the same total withdrawal."@en .

    int:Equation_TOP_TIC a VDI2206:MathematicalModel ;
        rdfs:label "TOP_TIC PI control law"@en ;
        ip:sourceFile "integrated_plant/control.py" ;
        ip:sourceSymbol "PIController.output" ;
        rdfs:comment "u = clip(bias + Kp*(SP-PV) + integral, u_min, u_max); integral += Kp/Ti*(SP-PV)*dt outside deadband (PV first-order filtered); AUTO/MANUAL transfer uses tracking/back-calculation. Kp=-10.5, Ti=0.3 h, deadband=0.1, PV filter time constant=4 min."@en .

    int:Equation_Tray_Energy a VDI2206:MathematicalModel ;
        rdfs:label "Tray energy balance"@en ;
        rdfs:comment "dU_i/dt = L_in*hL_in + V_in*hV_in + F_i*h_feed - L_i*hL_i - V_i*hV_i."@en .

    int:Equation_Tray_Hydraulics a VDI2206:MathematicalModel ;
        rdfs:label "Tray hydraulics and vapour flow"@en ;
        rdfs:comment "L_i = L_nominal*(M_i/M_nominal)^1.5; V_i = Cv_vap*sqrt(max(P_i-P_above,0)); VLE uses bubble pressure and y_light relations."@en .

    int:PO_CSTR_Dynamics a VDI3682:ProcessOperator ;
        rdfs:label "PO – CSTR Reaction and Balances"@en ;
        ip:sourceFile "integrated_plant/cstr.py" ;
        ip:sourceSymbol "CSTRDAE.residual" ;
        CPSMod:processRealizesBehavior int:Equation_CSTR_Acetone,
            int:Equation_CSTR_Energy,
            int:Equation_CSTR_H2,
            int:Equation_CSTR_Mass,
            int:Equation_CSTR_Pressure,
            int:Equation_CSTR_Rate ;
        rdfs:comment "Direct-residual DAE for endothermic IPA dehydrogenation with liquid mass/component/energy and H2 inventory balances."@en ;
        VDI3682:hasInput int:information_ambient_temperature_K,
            int:information_catalyst_activity,
            int:information_cstr_heater_factor,
            int:information_cstr_outflow,
            int:information_fresh_feed_temperature_K,
            int:information_fresh_ipa_feed,
            int:product_cstr_liquid ;
        VDI3682:hasOutput int:information_cstr_holdup_kmol,
            int:information_cstr_temperature_K,
            int:information_cstr_x_acetone,
            int:product_H2,
            int:product_cstr_liquid ;
        VDI3682:hasSuccessor int:PO_Column_Stages,
            int:PO_H2_Removal ;
        VDI3682:isAssignedTo int:module_CSTR .

    int:PO_Condenser a VDI3682:ProcessOperator ;
        rdfs:label "PO – Condenser Capacity and Column Pressure"@en ;
        ip:sourceFile "integrated_plant/distillation.py" ;
        ip:sourceSymbol "DistillationDAE.condenser_capacity" ;
        CPSMod:processRealizesBehavior int:Equation_ColumnPressure,
            int:Equation_CondenserCapacity ;
        rdfs:comment "Condenser capacity is limited by available cooling duty; column pressure integrates the imbalance between top vapour generation and condensation."@en ;
        VDI3682:hasInput int:information_condenser_cooling_effectiveness,
            int:information_condenser_cooling_valve,
            int:information_cooling_water_temperature_K,
            int:product_overhead_vapor ;
        VDI3682:hasOutput int:information_column_pressure_bar,
            int:product_condensate ;
        VDI3682:hasSuccessor int:PO_RefluxDrum ;
        VDI3682:isAssignedTo int:module_CondenserDrum .

    int:PO_H2_Removal a VDI3682:ProcessOperator ;
        rdfs:label "PO – Hydrogen PCV/BDV/PSV Removal"@en ;
        ip:sourceFile "integrated_plant/cstr.py" ;
        ip:sourceSymbol "CSTRDAE.h2_flow_components" ;
        CPSMod:processRealizesBehavior int:Equation_H2_Removal ;
        rdfs:comment "Total H2 removal is the sum of normal PCV, emergency BDV, and passive PSV flows."@en ;
        VDI3682:hasInput int:information_cstr_bdv_valve,
            int:information_cstr_pressure_bar,
            int:information_cstr_vent_valve,
            int:product_H2 ;
        VDI3682:hasOutput int:information_cstr_h2_vent_kmol_h,
            int:product_h2_to_flare ;
        VDI3682:isAssignedTo int:module_H2Protection .

    int:PO_Reboiler a VDI3682:ProcessOperator ;
        rdfs:label "PO – Reboiler"@en ;
        ip:sourceFile "integrated_plant/distillation.py" ;
        ip:sourceSymbol "DistillationDAE.residual" ;
        CPSMod:processRealizesBehavior int:Equation_Reboiler ;
        rdfs:comment "Steam-heated dynamic reboiler returns vapour to tray 10 and withdraws bottoms; physical leak removes mass/component/enthalpy."@en ;
        VDI3682:hasInput int:information_bottoms_flow,
            int:information_reboiler_liquid_leak_kmol_h,
            int:information_steam_factor,
            int:information_steam_pressure_bar,
            int:product_bottoms ;
        VDI3682:hasOutput int:information_bottom_temperature_K,
            int:information_reboiler_holdup_kmol,
            int:information_reboiler_pressure_bar,
            int:product_bottoms ;
        VDI3682:isAssignedTo int:module_Reboiler .

    int:PO_RefluxDrum a VDI3682:ProcessOperator ;
        rdfs:label "PO – Reflux Drum"@en ;
        ip:sourceFile "integrated_plant/distillation.py" ;
        ip:sourceSymbol "DistillationDAE.residual" ;
        CPSMod:processRealizesBehavior int:Equation_RefluxDrum ;
        rdfs:comment "Reflux drum accumulates condensed overhead and splits withdrawal into reflux, distillate and physical leak."@en ;
        VDI3682:hasInput int:information_distillate_flow,
            int:information_drum_liquid_leak_kmol_h,
            int:information_reflux_flow,
            int:product_condensate ;
        VDI3682:hasOutput int:information_distillate_x_acetone,
            int:information_drum_holdup_kmol,
            int:product_distillate ;
        VDI3682:hasSuccessor int:PO_Column_Stages ;
        VDI3682:isAssignedTo int:module_CondenserDrum .

