        ip:mode "15_min_rectangular_step_±10_percent" ;
        ip:sourceFile "integrated_plant/scenario.py" ;
        ip:sourceSymbol "randomized_step_disturbance_scenario" ;
        rdfs:comment "Normal-variability generator may apply one 15 min rectangular ±10% step to this variable; different disturbances may overlap."@en .

    int:energy_emergency_cooling a VDI3682:Energy ;
        rdfs:label "Emergency reactor cooling"@en ;
        rdfs:comment "Independent emergency cooling path, normally off."@en .

    int:information_bottoms_x_acetone a VDI3682:Information ;
        rdfs:label "Bottoms acetone mole fraction"@en ;
        CPSMod:isCharacterizedByParameter int:obs_param_bottoms_x_acetone ;
        CPSMod:isObservedBySensor int:AIT-202B ;
        DINEN61360:has_Data_Element int:DE_bottoms_x_acetone ;
        rdfs:comment "Measured/observable information tag: bottoms_x_acetone."@en .

