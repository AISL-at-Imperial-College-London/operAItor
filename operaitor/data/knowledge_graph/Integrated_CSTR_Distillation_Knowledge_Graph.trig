    int:CV-201 a DIN17359:DiagnosticSubject,
            VDI2206:Actuator ;
        rdfs:label "Condenser Cooling-Water Valve"@en ;
        rdfs:comment "Column pressure manipulated variable; nominal opening 60%."@en ;
        VDI2206:isConnectedWith int:E-201 .

    int:E-101 a DIN17359:DiagnosticSubject,
            VDI2206:Actuator ;
        rdfs:label "CSTR Heating Jacket"@en ;
        DIN17359:DiagnosticSubjectHasFault int:fault_cstr_heater_output_freeze,
            int:fault_reactor_heater_stuck_high ;
        rdfs:comment "Normal heating path, UA = 165000 kJ/h/K, manipulated by cstr_heater_factor."@en ;
        VDI2206:isConnectedWith int:R-101 .

    int:Equation_CSTR_Energy a VDI2206:MathematicalModel ;
        rdfs:label "CSTR energy balance"@en ;
        rdfs:comment "dU/dt = F_in*h_in - F_liq*out*h_out - F_H2*h_H2 + Q_jacket - Q_loss - Q_emergency - rate*ΔH_rxn."@en .

    int:Equation_CSTR_Mass a VDI2206:MathematicalModel ;
        rdfs:label "CSTR liquid balance"@en ;
        rdfs:comment "dM/dt = feed_flow - (liquid_outflow + max(liquid_leak_flow,0))."@en .

    int:Equation_CSTR_Rate a VDI2206:MathematicalModel ;
        rdfs:label "CSTR reaction rate"@en ;
        rdfs:comment "rate = catalyst_activity * k_ref * exp[-E/R*(1/T - 1/T_ref)] * positive(M_liq - n_acetone)."@en .

    int:Equation_ColumnPressure a VDI2206:MathematicalModel ;
        rdfs:label "Lumped column pressure dynamics"@en ;
        rdfs:comment "dPcond/dt = (V_top - Fcond) / vapour_capacitance."@en .

    int:Equation_CondenserCapacity a VDI2206:MathematicalModel ;
        rdfs:label "Condenser capacity"@en ;
        rdfs:comment "Qavail = UA_condenser*cooling_valve*effectiveness*positive(T_top-T_CW); capacity = Qavail/condenser_energy_per_kmol; Fcond = min(capacity,demand)."@en .

    int:Equation_Reboiler a VDI2206:MathematicalModel ;
        rdfs:label "Reboiler balances"@en ;
        rdfs:comment "Q_reb = UA_reboiler*steam_factor*positive(T_steam - T_reboiler); total, light-component and energy balances include bottoms + leak withdrawal and vapour return."@en .

    int:Equation_Tray_Component a VDI2206:MathematicalModel ;
        rdfs:label "Tray light-component balance"@en ;
        rdfs:comment "dn_i/dt = L_in*x_in + V_in*y_in + F_i*z_i - L_i*x_i - V_i*y_i."@en .

    int:Equation_Tray_Total a VDI2206:MathematicalModel ;
        rdfs:label "Tray total balance"@en ;
        rdfs:comment "dM_i/dt = L_in + V_in + F_i - L_i - V_i."@en .

