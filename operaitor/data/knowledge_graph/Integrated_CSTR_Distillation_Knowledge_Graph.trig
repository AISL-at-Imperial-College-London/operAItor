    int:action_ACK_ALARM a ip:OperatorAction ;
        rdfs:label "ACK_ALARM"@en ;
        ip:actsOn int:alarm_BTM_X_H,
            int:alarm_COL_P_H,
            int:alarm_COL_P_HH,
            int:alarm_COL_TRAY_L,
            int:alarm_DIST_X_L,
            int:alarm_DR_L_HH,
            int:alarm_DR_L_LL,
            int:alarm_P101_TRIP,
            int:alarm_P102_TRIP,
            int:alarm_P201_TRIP,
            int:alarm_P202_TRIP,
            int:alarm_P203_TRIP,
            int:alarm_RB_L_HH,
            int:alarm_RB_L_LL,
            int:alarm_R_L_H,
            int:alarm_R_L_HH,
            int:alarm_R_L_L,
            int:alarm_R_L_LL,
            int:alarm_R_P_H,
            int:alarm_R_P_HH,
            int:alarm_R_T_H,
            int:alarm_R_T_HH ;
        rdfs:comment "Acknowledge one or all operator alarms; acknowledgement does not reset SIF latches."@en .

    int:action_NO_ACTION a ip:OperatorAction ;
        rdfs:label "NO_ACTION"@en ;
        rdfs:comment "No supervisory change."@en .

    int:action_OPERATE_AUXILIARY a ip:OperatorAction ;
        rdfs:label "OPERATE_AUXILIARY"@en ;
        ip:actsOn int:act_param_cstr_bdv_valve,
            int:act_param_cstr_emergency_cooling_factor ;
        rdfs:comment "Command H2_BDV or EMERGENCY_COOLING, each in [0,1]."@en .

    int:action_RESET_SIF a ip:OperatorAction ;
        rdfs:label "RESET_SIF"@en ;
        ip:actsOn int:SIF_COL_L_LL,
            int:SIF_COL_P_HH,
            int:SIF_DR_L_HH,
            int:SIF_DR_L_LL,
            int:SIF_RB_L_HH,
            int:SIF_RB_L_LL,
            int:SIF_R_L_HH,
            int:SIF_R_L_LL,
            int:SIF_R_P_HH,
            int:SIF_R_P_HHH,
            int:SIF_R_T_HH ;
        rdfs:comment "Request SIF reset; only latches whose process variables are inside reset hysteresis are cleared."@en .

    int:action_SELECT_PRIMARY a ip:OperatorAction ;
        rdfs:label "SELECT_PRIMARY"@en ;
        ip:actsOn int:pump_train_BOTTOMS,
            int:pump_train_CSTR_OUTLET,
            int:pump_train_DISTILLATE,
            int:pump_train_FEED,
            int:pump_train_REFLUX ;
        rdfs:comment "Return to a healthy primary pump in a named pump train."@en .

    int:action_SET_MANUAL_OUTPUT a ip:OperatorAction ;
        rdfs:label "SET_MANUAL_OUTPUT"@en ;
        ip:actsOn int:controller_BOT_TIC,
            int:controller_COL_PIC,
            int:controller_DR_LIC,
            int:controller_RB_LIC,
            int:controller_R_LIC,
            int:controller_R_PIC,
            int:controller_R_TIC,
            int:controller_TOP_TIC ;
        rdfs:comment "Set loop manual output after the loop is in MANUAL, within controller MV bounds."@en .

    int:action_SET_MODE a ip:OperatorAction ;
        rdfs:label "SET_MODE"@en ;
        ip:actsOn int:controller_BOT_TIC,
            int:controller_COL_PIC,
            int:controller_DR_LIC,
            int:controller_RB_LIC,
            int:controller_R_LIC,
            int:controller_R_PIC,
            int:controller_R_TIC,
            int:controller_TOP_TIC ;
        rdfs:comment "Transfer any named regulatory loop between AUTO and MANUAL."@en .

    int:action_SET_SETPOINT a ip:OperatorAction ;
        rdfs:label "SET_SETPOINT"@en ;
        ip:actsOn int:controller_BOT_TIC,
            int:controller_COL_PIC,
            int:controller_DR_LIC,
            int:controller_RB_LIC,
            int:controller_R_LIC,
            int:controller_R_PIC,
            int:controller_R_TIC,
            int:controller_TOP_TIC ;
        rdfs:comment "Change any named regulatory loop setpoint within its LoopAccessSpec bounds."@en .

    int:action_SET_THROUGHPUT a ip:OperatorAction ;
        rdfs:label "SET_THROUGHPUT"@en ;
        ip:actsOn int:act_param_fresh_ipa_feed ;
        ip:allowedMaximum 1.5e+02 ;
        ip:allowedMinimum 0e+00 ;
        ip:unit "kmol/h" ;
        rdfs:comment "Set persistent plant throughput target, allowed range 0–150 kmol/h."@en .

    int:action_START_SPARE a ip:OperatorAction ;
        rdfs:label "START_SPARE"@en ;
        ip:actsOn int:pump_train_BOTTOMS,
