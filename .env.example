# Copy to .env (git-ignored) in the directory you run operaitor from.
# Used for local runs; the hosted app (PLANT_HOSTED=1) ignores it and uses visitor keys.
OPENAI_API_KEY=sk-...
# Optional for gpt-5 / o-series models: minimal | low (default) | medium | high
# PLANT_REASONING_EFFORT=low
# Local models: any OpenAI-compatible server
# PLANT_LLM_BASE_URL=http://localhost:1234/v1
